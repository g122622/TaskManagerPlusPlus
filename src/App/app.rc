// ============================================================================
// Executable resources: the application icon and its version information.
//
// This is the only .rc in the project, and it is compiled into tmpp.exe by the
// C++ resource compiler. Two things end up in the image because of it:
//
//   * RT_GROUP_ICON id 1. Windows shows the lowest-numbered icon group for an
//     executable, so id 1 is what Explorer, the taskbar and the Alt-Tab list
//     pick up. app.ico holds eight images (256, 64, 48, 40, 32, 24, 20 and
//     16 pixels, all 32bpp) so every one of those surfaces gets a crisp bitmap
//     instead of a downscaled 32x32.
//
//   * RT_VERSION, which is what the Details tab of the file's property sheet
//     reads. Before this file existed the executable carried no version at all.
//
// The version below mirrors the "version" field of vcpkg.json, which is the
// manifest's notion of the product version. tools/package.ps1 reads that field
// and refuses to build a package when the two disagree, so drift is caught when
// a release is assembled rather than shipped.
//
// The manifest is deliberately NOT here. It is embedded through the project's
// <Manifest> item so that the Windows App SDK's activatable-class registrations
// are merged into it; declaring RT_MANIFEST here as well would produce two
// manifests and fail to link.
// ============================================================================

#include <winver.h>

#define TMPP_VERSION         0,1,0,0
#define TMPP_VERSION_STRING  "0.1.0.0"
#define TMPP_PRODUCT_STRING  "0.1.0"

#define TMPP_PRODUCT_NAME    "TaskManagerPlusPlus"
#define TMPP_INTERNAL_NAME   "tmpp"
#define TMPP_ORIGINAL_NAME   "tmpp.exe"
#define TMPP_COPYRIGHT       "Copyright (c) 2026 g122622. MIT licensed."

#define IDI_TMPP_APP         1

// ---------------------------------------------------------------------------
// Icon
// ---------------------------------------------------------------------------

IDI_TMPP_APP ICON "app.ico"

// ---------------------------------------------------------------------------
// Version
// ---------------------------------------------------------------------------

VS_VERSION_INFO VERSIONINFO
 FILEVERSION    TMPP_VERSION
 PRODUCTVERSION TMPP_VERSION
 FILEFLAGSMASK  VS_FFI_FILEFLAGSMASK
#ifdef TMPP_DEBUG
 FILEFLAGS      VS_FF_DEBUG
#else
 FILEFLAGS      0x0L
#endif
 FILEOS         VOS_NT_WINDOWS32
 FILETYPE       VFT_APP
 FILESUBTYPE    VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        // 0409 is English (United States) and 04b0 is Unicode; the pair has to
        // match the Translation value in the VarFileInfo block below.
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName",      TMPP_PRODUCT_NAME
            VALUE "FileDescription",  TMPP_PRODUCT_NAME
            VALUE "FileVersion",      TMPP_VERSION_STRING
            VALUE "InternalName",     TMPP_INTERNAL_NAME
            VALUE "LegalCopyright",   TMPP_COPYRIGHT
            VALUE "OriginalFilename", TMPP_ORIGINAL_NAME
            VALUE "ProductName",      TMPP_PRODUCT_NAME
            VALUE "ProductVersion",   TMPP_PRODUCT_STRING
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END

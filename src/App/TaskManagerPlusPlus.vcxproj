<?xml version="1.0" encoding="utf-8"?>
<Project ToolsVersion="15.0" DefaultTargets="Build" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">

  <PropertyGroup Label="NuGet">
    <NugetPackageDirectory Condition="'$(NugetPackageDirectory)'==''">packages</NugetPackageDirectory>
    <RestoreProjectStyle>PackageReference</RestoreProjectStyle>
    <!-- Native project markers so NuGet restores native (not managed) assets. -->
    <NuGetTargetMoniker>native,Version=v0.0</NuGetTargetMoniker>
    <NuGetTargetPlatformIdentifier>Windows</NuGetTargetPlatformIdentifier>
    <NuGetTargetPlatformVersion>$(WindowsTargetPlatformVersion)</NuGetTargetPlatformVersion>
  </PropertyGroup>

  <!-- ProjectConfigurations must be declared before Microsoft.Cpp.Default.props so that
       OutputPath/IntDir are resolved for the selected Configuration|Platform pair. -->
  <ItemGroup Label="ProjectConfigurations">
    <ProjectConfiguration Include="Debug|x64">
      <Configuration>Debug</Configuration>
      <Platform>x64</Platform>
    </ProjectConfiguration>
    <ProjectConfiguration Include="Release|x64">
      <Configuration>Release</Configuration>
      <Platform>x64</Platform>
    </ProjectConfiguration>
    <ProjectConfiguration Include="RelWithDebInfo|x64">
      <Configuration>RelWithDebInfo</Configuration>
      <Platform>x64</Platform>
    </ProjectConfiguration>
  </ItemGroup>

  <PropertyGroup Label="Globals">
    <CppWinRTOptimized>true</CppWinRTOptimized>
    <CppWinRTRootNamespaceAutoMerge>true</CppWinRTRootNamespaceAutoMerge>
    <MinimalCoreWin>true</MinimalCoreWin>
    <ProjectGuid>{2F1A4C7E-9D33-4B62-8A15-7C4E5D9B1A20}</ProjectGuid>
    <ProjectName>TaskManagerPlusPlus</ProjectName>
    <RootNamespace>tmpp</RootNamespace>
    <!-- TargetName must match RootNamespace so the produced .exe/.pri/.winmd share a name. -->
    <TargetName>$(RootNamespace)</TargetName>
    <DefaultLanguage>en-US</DefaultLanguage>
    <MinimumVisualStudioVersion>16.0</MinimumVisualStudioVersion>
    <AppContainerApplication>false</AppContainerApplication>
    <!-- NOTE: ApplicationType/ApplicationTypeRevision are intentionally NOT set.
         This VS install has no "Application Type\Windows Store\10.0" platform folder,
         so declaring "Windows Store" makes MSBuild search for the toolset under that
         missing folder, which breaks SDK resolution from the command line. A WinUI 3
         desktop app only needs UseWinUI + DesktopCompatible. -->
    <!-- Pinned SDK: the "10.0" (latest-installed) alias is unreliable from a bare
         command line and can resolve to a version that is not installed. -->
    <WindowsTargetPlatformVersion Condition="'$(WindowsTargetPlatformVersion)'==''">10.0.26100.0</WindowsTargetPlatformVersion>
    <WindowsTargetPlatformMinVersion>10.0.22000.0</WindowsTargetPlatformMinVersion>
    <UseWinUI>true</UseWinUI>
    <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
    <EnableMsixTooling>true</EnableMsixTooling>
    <!-- Self-contained deployment is the shipping model: the Windows App SDK
         runtime ships next to the exe so the app runs without a system-wide
         runtime install. -->
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <AppxPackage>false</AppxPackage>
    <WindowsPackageType>None</WindowsPackageType>
  </PropertyGroup>

  <ItemGroup>
    <!-- Component packages, not the Microsoft.WindowsAppSDK metapackage: it would
         also pull AI, ML and Widgets into the self-contained payload even though
         this app uses none of them. See Directory.Packages.props. -->
    <PackageReference Include="Microsoft.WindowsAppSDK.Base" />
    <PackageReference Include="Microsoft.WindowsAppSDK.Foundation" />
    <PackageReference Include="Microsoft.WindowsAppSDK.InteractiveExperiences" />
    <PackageReference Include="Microsoft.WindowsAppSDK.WinUI" />
    <PackageReference Include="Microsoft.WindowsAppSDK.DWrite" />
    <PackageReference Include="Microsoft.WindowsAppSDK.Runtime" />
    <PackageReference Include="Microsoft.Windows.CppWinRT" />
  </ItemGroup>

  <!-- vcpkg manifest mode. MSBuild's vcpkg integration defaults to classic mode,
       which only looks in <vcpkg-root>\installed. Enabling the manifest makes it
       consume <repo>\vcpkg_installed\<triplet>, where this project's manifest
       dependencies (spdlog, nlohmann-json, gtest) are installed.

       VcpkgInstalledDir is set explicitly to work around a bug in this vcpkg
       version: vcpkg.targets:79 already appends $(VcpkgTriplet) when deriving
       _ZVcpkgInstalledDir, and line 90 appends the triplet again, producing the
       doubled path vcpkg_installed\x64-windows\x64-windows\include. Supplying the
       value directly skips the derivation. It is conditional because the same
       workaround is wrong for a newer vcpkg.targets that no longer appends the
       triplet (GitHub's runner); CI overrides VcpkgInstalledDir with
       vcpkg_installed\x64-windows. -->
  <PropertyGroup>
    <VcpkgEnableManifest>true</VcpkgEnableManifest>
    <VcpkgManifestInstall>false</VcpkgManifestInstall>
    <VcpkgInstalledDir Condition="'$(VcpkgInstalledDir)'==''">$(MSBuildThisFileDirectory)..\..\vcpkg_installed\</VcpkgInstalledDir>
  </PropertyGroup>

  <!-- Explicit intermediate and output locations. The VC targets assign
       OutputPath from OutDir unconditionally (Microsoft.CppCommon.Targets) and only
       default OutDir to $(SolutionDir)..., which is undefined when a project is built
       from the command line. Setting both here keeps command-line and IDE builds
       consistent. -->
  <PropertyGroup>
    <OutDir>$(MSBuildThisFileDirectory)..\..\build\$(Platform)\$(Configuration)\</OutDir>
    <IntDir>$(MSBuildThisFileDirectory)..\..\build\obj\$(Platform)\$(Configuration)\$(ProjectName)\</IntDir>
  </PropertyGroup>

  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.Default.props" />

  <PropertyGroup Label="Configuration">
    <ConfigurationType>Application</ConfigurationType>
    <PlatformToolset Condition="'$(PlatformToolset)'==''">v145</PlatformToolset>
    <CharacterSet>Unicode</CharacterSet>
    <DesktopCompatible>true</DesktopCompatible>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)'=='Debug'" Label="Configuration">
    <UseDebugLibraries>true</UseDebugLibraries>
    <LinkIncremental>true</LinkIncremental>
  </PropertyGroup>
  <!-- Release ships no debug information at all: no /Zi, no PDB, no linker debug
       directory. RelWithDebInfo is the configuration that keeps it, so the two are
       no longer the same thing. See the DebugInformationFormat note below. -->
  <PropertyGroup Condition="'$(Configuration)'=='Release'" Label="Configuration">
    <UseDebugLibraries>false</UseDebugLibraries>
    <WholeProgramOptimization>true</WholeProgramOptimization>
    <LinkIncremental>false</LinkIncremental>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)'=='RelWithDebInfo'" Label="Configuration">
    <UseDebugLibraries>false</UseDebugLibraries>
    <WholeProgramOptimization>true</WholeProgramOptimization>
    <LinkIncremental>false</LinkIncremental>
  </PropertyGroup>

  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.props" />

  <PropertyGroup>
    <!-- For unpackaged C++ WinUI apps the resource URI carries an extra root namespace,
         so the default AppxPriInitialPath must stay empty. -->
    <AppxPriInitialPath>
    </AppxPriInitialPath>
  </PropertyGroup>

  <ImportGroup Label="ExtensionSettings">
  </ImportGroup>

  <ImportGroup Label="PropertySheets">
    <Import Project="$(UserRootDir)\Microsoft.Cpp.$(Platform).user.props" Condition="exists('$(UserRootDir)\Microsoft.Cpp.$(Platform).user.props')" Label="LocalAppDataPlatform" />
  </ImportGroup>

  <!-- Product version, injected by CI as YYMMDDNN (e.g. 26111901) split into its
       four numeric fields. app.rc reads the generated header; the defaults keep a
       plain local build at 0.1.0 until the version is passed in. See
       tools/version.ps1 and tools/package.ps1. -->
  <PropertyGroup>
    <TMPP_VER_MAJOR Condition="'$(TMPP_VER_MAJOR)'==''">0</TMPP_VER_MAJOR>
    <TMPP_VER_MINOR Condition="'$(TMPP_VER_MINOR)'==''">1</TMPP_VER_MINOR>
    <TMPP_VER_PATCH Condition="'$(TMPP_VER_PATCH)'==''">0</TMPP_VER_PATCH>
    <TMPP_VER_BUILD Condition="'$(TMPP_VER_BUILD)'==''">0</TMPP_VER_BUILD>
    <TMPP_VER_STR Condition="'$(TMPP_VER_STR)'==''">0.1.0.0</TMPP_VER_STR>
    <TMPP_VER_DISPLAY Condition="'$(TMPP_VER_DISPLAY)'==''">0.1.0</TMPP_VER_DISPLAY>
  </PropertyGroup>

  <ItemDefinitionGroup>
    <ClCompile>
      <!-- No precompiled header. The WinRT projections expand to roughly 930 MB of
           precompiled state, which costs more to read per file than re-parsing the
           headers does, and it previously tripped C1076 (internal heap limit).
           Parallel compilation is what makes this build fast instead. See src/UI/Pch.h
           for the measurement. -->
      <WarningLevel>Level4</WarningLevel>
      <LanguageStandard>stdcpp20</LanguageStandard>
      <ConformanceMode>true</ConformanceMode>
      <AdditionalOptions>%(AdditionalOptions) /bigobj /utf-8 /Zm500 /FS</AdditionalOptions>
      <DebugInformationFormat>ProgramDatabase</DebugInformationFormat>
      <MinimalRebuild>false</MinimalRebuild>
      <MultiProcessorCompilation>true</MultiProcessorCompilation>
      <!-- Headers are included as "Core/...", "UI/...", so src\ is the include root. -->
      <AdditionalIncludeDirectories>$(MSBuildThisFileDirectory)..;%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories>
    </ClCompile>
    <!-- app.rc includes the generated app-version.h from the intermediate directory. -->
    <ResourceCompile>
      <AdditionalIncludeDirectories>$(IntDir)version;%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories>
    </ResourceCompile>
  </ItemDefinitionGroup>

  <ItemDefinitionGroup Condition="'$(Configuration)'=='Debug'">
    <ClCompile>
      <PreprocessorDefinitions>_DEBUG;%(PreprocessorDefinitions)</PreprocessorDefinitions>
    </ClCompile>
    <!-- The resource compiler does not inherit the compiler's preprocessor
         definitions, so the Debug flag has to be handed to it separately. app.rc
         turns it into the VS_FF_DEBUG bit of the version resource, which is what
         makes the file's property sheet report a debug build. -->
    <ResourceCompile>
      <PreprocessorDefinitions>TMPP_DEBUG=1;%(PreprocessorDefinitions)</PreprocessorDefinitions>
    </ResourceCompile>
  </ItemDefinitionGroup>

  <!-- Release: no debug information anywhere. The shared item definition above asks
       for ProgramDatabase, so it is overridden to None here; the linker is likewise
       told not to emit a debug directory or a PDB. This is what makes Release a true
       release rather than a RelWithDebInfo build under another name. -->
  <ItemDefinitionGroup Condition="'$(Configuration)'=='Release'">
    <ClCompile>
      <PreprocessorDefinitions>NDEBUG;%(PreprocessorDefinitions)</PreprocessorDefinitions>
      <DebugInformationFormat>None</DebugInformationFormat>
    </ClCompile>
    <Link>
      <EnableCOMDATFolding>true</EnableCOMDATFolding>
      <OptimizeReferences>true</OptimizeReferences>
      <GenerateDebugInformation>false</GenerateDebugInformation>
    </Link>
  </ItemDefinitionGroup>

  <!-- RelWithDebInfo: full optimisation with debug information, which is what the
       Release configuration used to be. Keep this when a crash dump or a profiler
       needs to resolve symbols; ship Release instead. -->
  <ItemDefinitionGroup Condition="'$(Configuration)'=='RelWithDebInfo'">
    <ClCompile>
      <PreprocessorDefinitions>NDEBUG;%(PreprocessorDefinitions)</PreprocessorDefinitions>
      <DebugInformationFormat>ProgramDatabase</DebugInformationFormat>
    </ClCompile>
    <Link>
      <EnableCOMDATFolding>true</EnableCOMDATFolding>
      <OptimizeReferences>true</OptimizeReferences>
      <GenerateDebugInformation>true</GenerateDebugInformation>
    </Link>
  </ItemDefinitionGroup>

  <ItemGroup>
    <Manifest Include="app.manifest" />
    <!-- The icon and version resources. Kept apart from app.manifest on purpose:
         see the header comment in app.rc. -->
    <ResourceCompile Include="app.rc" />
  </ItemGroup>

  <!-- app.rc cannot read MSBuild properties, so the version is materialised as a
       header before rc.exe runs. WriteOnlyWhenDifferent keeps an unchanged
       version from recompiling the resource on every incremental build. -->
  <Target Name="GenerateAppVersionHeader" BeforeTargets="PrepareForBuild">
    <MakeDir Directories="$(IntDir)version" />
    <WriteLinesToFile
        File="$(IntDir)version\app-version.h"
        Overwrite="true"
        WriteOnlyWhenDifferent="true"
        Lines="#define TMPP_VERSION $(TMPP_VER_MAJOR),$(TMPP_VER_MINOR),$(TMPP_VER_PATCH),$(TMPP_VER_BUILD);#define TMPP_VERSION_STRING &quot;$(TMPP_VER_STR)&quot;;#define TMPP_PRODUCT_STRING &quot;$(TMPP_VER_DISPLAY)&quot;" />
  </Target>

  <ItemGroup>
    <ClInclude Include="App.h" />
    <ClInclude Include="MainWindow.h" />
    <ClInclude Include="StartupLog.h" />
    <ClInclude Include="WinRT.h" />
    <ClInclude Include="..\UI\Controls\ProcessDetailPanel.h" />
  </ItemGroup>

  <!-- The UI is composed in C++. No Page or ApplicationDefinition items exist,
       so no XAML compiler step is required. The UI layer's sources are compiled
       into this project rather than into a separate library, because there is one
       consumer and a project would add no boundary. -->
  <ItemGroup>
    <ClCompile Include="App.cpp" />
    <ClCompile Include="MainWindow.cpp" />
    <ClCompile Include="..\UI\Views\AboutPage.cpp" />
    <ClCompile Include="main.cpp" />
    <ClCompile Include="..\..\tests\ui\ThemeVerification.cpp" Condition="'$(Configuration)'=='Debug'" />
    <ClCompile Include="..\..\tests\ui\WindowVerification.cpp" Condition="'$(Configuration)'=='Debug'" />
    <ClCompile Include="..\UI\Theming\Controls.cpp" />
    <ClCompile Include="..\UI\Charts\CoreGrid.cpp" />
    <ClCompile Include="..\UI\Views\CpuPage.cpp" />
    <ClCompile Include="..\UI\Views\DiskPage.cpp" />
    <ClCompile Include="..\UI\Views\GpuPage.cpp" />
    <ClCompile Include="..\UI\Diagnostics.cpp" />
    <ClCompile Include="..\UI\Localization.cpp" />
    <ClCompile Include="..\UI\Theming\Formatting.cpp">
    </ClCompile>
    <ClCompile Include="..\UI\Charts\HistoryChart.cpp" />
    <ClCompile Include="..\UI\Charts\MemoryCompositionBar.cpp" />
    <ClCompile Include="..\UI\Views\MemoryPage.cpp" />
    <ClCompile Include="..\UI\Views\NetworkPage.cpp" />
    <ClCompile Include="..\UI\Views\PerformanceView.cpp" />
    <ClCompile Include="..\UI\Views\ProcessesView.cpp" />
    <ClCompile Include="..\UI\Views\SettingsPage.cpp" />
    <ClCompile Include="..\UI\Lists\ProcessListModel.cpp">
    </ClCompile>
    <ClCompile Include="..\UI\Lists\ColumnResizeHandle.cpp" />
    <ClCompile Include="..\UI\Lists\ProcessIconCache.cpp" />
    <ClCompile Include="..\UI\Lists\RowHost.cpp" />
    <ClCompile Include="..\UI\Charts\Sparkline.cpp" />
    <ClCompile Include="..\UI\Controls\ProcessDetailPanel.cpp" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Core\tmpp_core.vcxproj">
      <Project>{3A8C6F27-5E94-4B71-A0D3-8F2C9E4B6D15}</Project>
    </ProjectReference>
    <ProjectReference Include="..\Domain\tmpp_domain.vcxproj">
      <Project>{7D4B2E96-3C51-4A87-B902-6E5F1D80C4A7}</Project>
    </ProjectReference>
    <ProjectReference Include="..\Platform\tmpp_platform.vcxproj">
      <Project>{5C3E8A41-7B92-4D18-9E63-1A8F2D4C7E30}</Project>
    </ProjectReference>
  </ItemGroup>

  <ItemGroup>
    <PRIResource Include="Resources.resw" />
  </ItemGroup>

  <ItemGroup>
    <LocaleResource Include="$(MSBuildProjectDirectory)\..\..\assets\locales\*.json" />
  </ItemGroup>
  <Target Name="CopyLocaleResources" AfterTargets="Build">
    <Copy SourceFiles="@(LocaleResource)" DestinationFolder="$(OutDir)assets\locales" SkipUnchangedFiles="true" />
  </Target>

  <!-- Prefer the component-package payload over the Runtime package's MSIX.
       The MSIX is a superset that still carries AI, ML and Widgets binaries,
       even though this project no longer references those component packages
       (see Directory.Packages.props). Clearing MicrosoftWindowsAppSDKPackageDir
       switches Microsoft.WindowsAppSDK.SelfContained.targets to its component
       path, which copies exactly the referenced packages and builds the WinRT
       manifest from their fragments, so the manifest cannot reference a binary
       that is not shipped. This must come after the NuGet props are imported. -->
  <PropertyGroup Condition="'$(WindowsAppSDKSelfContained)'=='true'">
    <MicrosoftWindowsAppSDKPackageDir></MicrosoftWindowsAppSDKPackageDir>
    <!-- WebView2's targets normally infer this from a non-empty
         MicrosoftWindowsAppSDKPackageDir. Without it the WinUI projection
         needs CoreWebView2 metadata that is no longer referenced and cppwinrt
         fails. This is WinRT, not the Win32 loader, so the setting is correct
         for an unpackaged WinUI app regardless of package mode. -->
    <WebView2UseWinRT>true</WebView2UseWinRT>
  </PropertyGroup>

  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.targets" />
</Project>

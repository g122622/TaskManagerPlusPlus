<?xml version="1.0" encoding="utf-8"?>
<Project ToolsVersion="15.0" DefaultTargets="Build" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">

  <PropertyGroup Label="NuGet">
    <NugetPackageDirectory Condition="'$(NugetPackageDirectory)'==''">packages</NugetPackageDirectory>
    <RestoreProjectStyle>PackageReference</RestoreProjectStyle>
    <!-- Native project markers so NuGet restores native (not managed) assets. -->
    <NuGetTargetMoniker>native,Version=v0.0</NuGetTargetMoniker>
    <NuGetTargetPlatformIdentifier>Windows</NuGetTargetPlatformIdentifier>
    <NuGetTargetPlatformVersion>$(WindowsTargetPlatformVersion)</NuGetTargetPlatformVersion>
  </PropertyGroup>

  <!-- ProjectConfigurations must be declared before Microsoft.Cpp.Default.props so that
       OutputPath/IntDir are resolved for the selected Configuration|Platform pair. -->
  <ItemGroup Label="ProjectConfigurations">
    <ProjectConfiguration Include="Debug|x64">
      <Configuration>Debug</Configuration>
      <Platform>x64</Platform>
    </ProjectConfiguration>
    <ProjectConfiguration Include="Release|x64">
      <Configuration>Release</Configuration>
      <Platform>x64</Platform>
    </ProjectConfiguration>
  </ItemGroup>

  <PropertyGroup Label="Globals">
    <CppWinRTOptimized>true</CppWinRTOptimized>
    <CppWinRTRootNamespaceAutoMerge>true</CppWinRTRootNamespaceAutoMerge>
    <MinimalCoreWin>true</MinimalCoreWin>
    <ProjectGuid>{2F1A4C7E-9D33-4B62-8A15-7C4E5D9B1A20}</ProjectGuid>
    <ProjectName>TaskManagerPlusPlus</ProjectName>
    <RootNamespace>tmpp</RootNamespace>
    <!-- TargetName must match RootNamespace so the produced .exe/.pri/.winmd share a name. -->
    <TargetName>$(RootNamespace)</TargetName>
    <DefaultLanguage>en-US</DefaultLanguage>
    <MinimumVisualStudioVersion>16.0</MinimumVisualStudioVersion>
    <AppContainerApplication>false</AppContainerApplication>
    <!-- NOTE: ApplicationType/ApplicationTypeRevision are intentionally NOT set.
         This VS install has no "Application Type\Windows Store\10.0" platform folder,
         so declaring "Windows Store" makes MSBuild search for the toolset under that
         missing folder, which breaks SDK resolution from the command line. A WinUI 3
         desktop app only needs UseWinUI + DesktopCompatible. -->
    <!-- Pinned SDK: the "10.0" (latest-installed) alias is unreliable from a bare
         command line and can resolve to a version that is not installed. -->
    <WindowsTargetPlatformVersion>10.0.26100.0</WindowsTargetPlatformVersion>
    <WindowsTargetPlatformMinVersion>10.0.22000.0</WindowsTargetPlatformMinVersion>
    <UseWinUI>true</UseWinUI>
    <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
    <EnableMsixTooling>true</EnableMsixTooling>
    <!-- Self-contained deployment is the shipping model: the Windows App SDK
         runtime ships next to the exe so the app runs without a system-wide
         runtime install. -->
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <AppxPackage>false</AppxPackage>
    <WindowsPackageType>None</WindowsPackageType>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" />
    <PackageReference Include="Microsoft.Windows.CppWinRT" />
  </ItemGroup>

  <!-- vcpkg manifest mode. MSBuild's vcpkg integration defaults to classic mode,
       which only looks in <vcpkg-root>\installed. Enabling the manifest makes it
       consume <repo>\vcpkg_installed\<triplet>, where this project's manifest
       dependencies (spdlog, nlohmann-json, gtest) are installed.

       VcpkgInstalledDir is set explicitly to work around a bug in this vcpkg
       version: vcpkg.targets:79 already appends $(VcpkgTriplet) when deriving
       _ZVcpkgInstalledDir, and line 90 appends the triplet again, producing the
       doubled path vcpkg_installed\x64-windows\x64-windows\include. Supplying the
       value directly skips the derivation. -->
  <PropertyGroup>
    <VcpkgEnableManifest>true</VcpkgEnableManifest>
    <VcpkgManifestInstall>false</VcpkgManifestInstall>
    <VcpkgInstalledDir>$(MSBuildThisFileDirectory)..\..\vcpkg_installed\</VcpkgInstalledDir>
  </PropertyGroup>

  <!-- Explicit intermediate and output locations. The VC targets assign
       OutputPath from OutDir unconditionally (Microsoft.CppCommon.Targets) and only
       default OutDir to $(SolutionDir)..., which is undefined when a project is built
       from the command line. Setting both here keeps command-line and IDE builds
       consistent. -->
  <PropertyGroup>
    <OutDir>$(MSBuildThisFileDirectory)..\..\build\$(Platform)\$(Configuration)\</OutDir>
    <IntDir>$(MSBuildThisFileDirectory)..\..\build\obj\$(Platform)\$(Configuration)\$(ProjectName)\</IntDir>
  </PropertyGroup>

  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.Default.props" />

  <PropertyGroup Label="Configuration">
    <ConfigurationType>Application</ConfigurationType>
    <PlatformToolset>v145</PlatformToolset>
    <CharacterSet>Unicode</CharacterSet>
    <DesktopCompatible>true</DesktopCompatible>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)'=='Debug'" Label="Configuration">
    <UseDebugLibraries>true</UseDebugLibraries>
    <LinkIncremental>true</LinkIncremental>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)'=='Release'" Label="Configuration">
    <UseDebugLibraries>false</UseDebugLibraries>
    <WholeProgramOptimization>true</WholeProgramOptimization>
    <LinkIncremental>false</LinkIncremental>
  </PropertyGroup>

  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.props" />

  <PropertyGroup>
    <!-- For unpackaged C++ WinUI apps the resource URI carries an extra root namespace,
         so the default AppxPriInitialPath must stay empty. -->
    <AppxPriInitialPath>
    </AppxPriInitialPath>
  </PropertyGroup>

  <ImportGroup Label="ExtensionSettings">
  </ImportGroup>

  <ImportGroup Label="PropertySheets">
    <Import Project="$(UserRootDir)\Microsoft.Cpp.$(Platform).user.props" Condition="exists('$(UserRootDir)\Microsoft.Cpp.$(Platform).user.props')" Label="LocalAppDataPlatform" />
  </ImportGroup>

  <ItemDefinitionGroup>
    <ClCompile>
      <!-- No precompiled header. The WinRT projections expand to roughly 930 MB of
           precompiled state, which costs more to read per file than re-parsing the
           headers does, and it previously tripped C1076 (internal heap limit).
           Parallel compilation is what makes this build fast instead. See src/UI/Pch.h
           for the measurement. -->
      <WarningLevel>Level4</WarningLevel>
      <LanguageStandard>stdcpp20</LanguageStandard>
      <ConformanceMode>true</ConformanceMode>
      <AdditionalOptions>%(AdditionalOptions) /bigobj /utf-8 /Zm500 /FS</AdditionalOptions>
      <DebugInformationFormat>ProgramDatabase</DebugInformationFormat>
      <MinimalRebuild>false</MinimalRebuild>
      <MultiProcessorCompilation>true</MultiProcessorCompilation>
      <!-- Headers are included as "Core/...", "UI/...", so src\ is the include root. -->
      <AdditionalIncludeDirectories>$(MSBuildThisFileDirectory)..;%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories>
    </ClCompile>
  </ItemDefinitionGroup>

  <ItemDefinitionGroup Condition="'$(Configuration)'=='Debug'">
    <ClCompile>
      <PreprocessorDefinitions>_DEBUG;%(PreprocessorDefinitions)</PreprocessorDefinitions>
    </ClCompile>
  </ItemDefinitionGroup>

  <ItemDefinitionGroup Condition="'$(Configuration)'=='Release'">
    <ClCompile>
      <PreprocessorDefinitions>NDEBUG;%(PreprocessorDefinitions)</PreprocessorDefinitions>
    </ClCompile>
    <Link>
      <EnableCOMDATFolding>true</EnableCOMDATFolding>
      <OptimizeReferences>true</OptimizeReferences>
    </Link>
  </ItemDefinitionGroup>

  <ItemGroup>
    <Manifest Include="app.manifest" />
  </ItemGroup>

  <ItemGroup>
    <ClInclude Include="App.h" />
    <ClInclude Include="MainWindow.h" />
    <ClInclude Include="StartupLog.h" />
    <ClInclude Include="WinRT.h" />
  </ItemGroup>

  <!-- The UI is composed in C++. No Page or ApplicationDefinition items exist,
       so no XAML compiler step is required. The UI layer's sources are compiled
       into this project rather than into a separate library, because there is one
       consumer and a project would add no boundary. -->
  <ItemGroup>
    <ClCompile Include="App.cpp" />
    <ClCompile Include="MainWindow.cpp" />
    <ClCompile Include="main.cpp" />
    <ClCompile Include="..\UI\Theming\Controls.cpp" />
    <ClCompile Include="..\UI\Charts\CoreGrid.cpp" />
    <ClCompile Include="..\UI\Views\CpuPage.cpp" />
    <ClCompile Include="..\UI\Views\DetailsPage.cpp" />
    <ClCompile Include="..\UI\Views\DiskPage.cpp" />
    <ClCompile Include="..\UI\Views\GpuPage.cpp" />
    <ClCompile Include="..\UI\Diagnostics.cpp" />
    <ClCompile Include="..\UI\Theming\Formatting.cpp">
    </ClCompile>
    <ClCompile Include="..\UI\Charts\HistoryChart.cpp" />
    <ClCompile Include="..\UI\Charts\MemoryCompositionBar.cpp" />
    <ClCompile Include="..\UI\Views\MemoryPage.cpp" />
    <ClCompile Include="..\UI\Views\NetworkPage.cpp" />
    <ClCompile Include="..\UI\Views\PerformanceView.cpp" />
    <ClCompile Include="..\UI\Views\ProcessesView.cpp" />
    <ClCompile Include="..\UI\Views\SettingsPage.cpp" />
    <ClCompile Include="..\UI\Lists\ProcessListModel.cpp">
    </ClCompile>
    <ClCompile Include="..\UI\Lists\ColumnResizeHandle.cpp" />
    <ClCompile Include="..\UI\Lists\ResizeCursor.cpp" />
    <ClCompile Include="..\UI\Lists\ProcessIconCache.cpp" />
    <ClCompile Include="..\UI\Lists\RowHost.cpp" />
    <ClCompile Include="..\UI\Charts\Sparkline.cpp" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Core\tmpp_core.vcxproj">
      <Project>{3A8C6F27-5E94-4B71-A0D3-8F2C9E4B6D15}</Project>
    </ProjectReference>
    <ProjectReference Include="..\Domain\tmpp_domain.vcxproj">
      <Project>{7D4B2E96-3C51-4A87-B902-6E5F1D80C4A7}</Project>
    </ProjectReference>
    <ProjectReference Include="..\Platform\tmpp_platform.vcxproj">
      <Project>{5C3E8A41-7B92-4D18-9E63-1A8F2D4C7E30}</Project>
    </ProjectReference>
  </ItemGroup>

  <ItemGroup>
    <PRIResource Include="Resources.resw" />
  </ItemGroup>

  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.targets" />
</Project>

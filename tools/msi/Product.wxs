<?xml version="1.0" encoding="utf-8"?>
<!--
  MSI package definition for TaskManagerPlusPlus.

  The payload components live in Payload.wxs, generated by harvest.ps1 from the
  packaged folder. This file only carries the parts that must not be generated:
  product identity, upgrade behaviour, the install-location dialog and the
  shortcut.

  Version (var.Version) is the Windows Installer form YY.MM.(DD*100+NN), e.g.
  26.11.1901 for 26111901. DisplayVersion is the YYMMDDNN string. See
  tools/version.ps1 for why the two forms differ.

  WixUI_InstallDir is what gives the user the directory picker; the property at
  the bottom points it at INSTALLFOLDER, which is what the harvested components
  are rooted in.
-->
<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi">

  <Product Id="*"
           Name="TaskManagerPlusPlus $(var.DisplayVersion)"
           Language="1033"
           Version="$(var.Version)"
           Manufacturer="g122622"
           UpgradeCode="{8E2B6B2A-1C59-4F1C-9E0A-1B7E7C5D0F11}">

    <Package InstallerVersion="500"
             Compressed="yes"
             InstallScope="perMachine"
             Platform="x64" />

    <!-- Replacing an older version is an upgrade, not a second install.
         Same-version reinstall is also handled (AllowSameVersionUpgrades is off,
         which is what makes a rebuild with a new sequence number an upgrade). -->
    <MajorUpgrade DowngradeErrorMessage="A newer version of TaskManagerPlusPlus is already installed." />

    <MediaTemplate EmbedCab="yes" />

    <Icon Id="ProductIcon" SourceFile="..\..\src\App\app.ico" />
    <Property Id="ARPPRODUCTICON" Value="ProductIcon" />
    <Property Id="ARPHELPLINK" Value="https://github.com/g122622/TaskManagerPlusPlus" />

    <!-- The directory page writes the user's choice back to INSTALLFOLDER. -->
    <Property Id="WIXUI_INSTALLDIR" Value="INSTALLFOLDER" />
    <UIRef Id="WixUI_InstallDir" />

    <Directory Id="TARGETDIR" Name="SourceDir">
      <Directory Id="ProgramFiles64Folder">
        <Directory Id="INSTALLFOLDER" Name="TaskManagerPlusPlus" />
      </Directory>
      <Directory Id="ProgramMenuFolder">
        <Directory Id="ApplicationProgramsFolder" Name="TaskManagerPlusPlus" />
      </Directory>
    </Directory>

    <DirectoryRef Id="ApplicationProgramsFolder">
      <Component Id="ApplicationShortcut" Guid="{4C8F2D91-6A3B-47E0-8D25-9B1E7F3A6C52}">
        <Shortcut Id="AppStartMenuShortcut"
                  Name="TaskManagerPlusPlus"
                  Description="Modern Windows task manager"
                  Target="[INSTALLFOLDER]tmpp.exe"
                  WorkingDirectory="INSTALLFOLDER"
                  Icon="ProductIcon" />
        <RemoveFolder Id="RemoveApplicationProgramsFolder" Directory="ApplicationProgramsFolder" On="uninstall" />
        <RegistryValue Root="HKLM"
                       Key="Software\g122622\TaskManagerPlusPlus"
                       Name="StartMenuShortcut"
                       Type="integer"
                       Value="1"
                       KeyPath="yes" />
      </Component>
    </DirectoryRef>

    <!-- PayloadComponents is generated by harvest.ps1. -->
    <Feature Id="MainFeature" Title="TaskManagerPlusPlus" Level="1">
      <ComponentGroupRef Id="PayloadComponents" />
      <ComponentRef Id="ApplicationShortcut" />
    </Feature>

  </Product>
</Wix>
